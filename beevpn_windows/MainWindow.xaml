<Window x:Class="BeeVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeeVPN"
        Height="710" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="app_icon.png">

    <!-- Window Styles & Control Templates -->
    <Window.Resources>
        <!-- Title Bar Button Template -->
        <ControlTemplate x:Key="TitleBtnTemplate" TargetType="Button">
            <Border x:Name="border" Background="Transparent" CornerRadius="4" Width="32" Height="28">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="CloseBtnTemplate" TargetType="Button">
            <Border x:Name="border" Background="Transparent" CornerRadius="4" Width="32" Height="28">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#E81123"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Big Power Connect Button Template -->
        <ControlTemplate x:Key="PowerBtnTemplate" TargetType="Button">
            <Grid>
                <Ellipse x:Name="glowRing" Width="128" Height="128" Fill="#1A1505" Stroke="#33270A" StrokeThickness="1"/>
                <Ellipse x:Name="btnBody" Width="112" Height="112">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFA700" Offset="0"/>
                            <GradientStop Color="#E67E00" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#FFA700" Opacity="0.4"/>
                    </Ellipse.Effect>
                </Ellipse>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="btnText" Text="CONNECT" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="btnIcon" Text="⚡" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBody" Property="Fill">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFB800" Offset="0"/>
                                <GradientStop Color="#FF9100" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="glowRing" Property="Fill" Value="#2A2007"/>
                    <Setter TargetName="glowRing" Property="Stroke" Value="#5C450E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="btnBody" Property="Width" Value="108"/>
                    <Setter TargetName="btnBody" Property="Height" Value="108"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- Main Window Root Border with Rounded Corners & Shadow -->
    <Border CornerRadius="16" Background="#111111" BorderBrush="#262626" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" /> <!-- Custom Title Bar -->
                <RowDefinition Height="*" />  <!-- Main Body Content -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0" Background="#161616" CornerRadius="15,15,0,0" BorderBrush="#222222" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Exact Android Vector Bee Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="24" Height="24" Margin="0,0,8,0">
                            <Canvas Width="128" Height="128">
                                <!-- Hexagonal Background Shield -->
                                <Path Fill="#151E2E" Stroke="#F59E0B" StrokeThickness="4" StrokeLineJoin="Round"
                                      Data="M64,6 L118,36 L118,92 L64,122 L10,92 L10,36 Z"/>
                                <!-- Bee Abdomen Striped -->
                                <Path Fill="#FBBF24" Data="M64,55 L74,55 C77,65 77,80 64,95 C51,80 51,65 54,55 Z"/>
                                <Path Fill="#0B0F19" Data="M56,66 L72,66 C71,72 70,75 64,80 C58,75 57,72 56,66 Z"/>
                                <Path Fill="#0B0F19" Data="M59,84 L69,84 C68,88 66,91 64,93 C62,91 60,88 59,84 Z"/>
                                <!-- Bee Head -->
                                <Path Fill="#F59E0B" Data="M64,40 C70,40 73,44 73,50 L55,50 C55,44 58,40 64,40 Z"/>
                                <!-- Bee Antennae -->
                                <Path Stroke="#FBBF24" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M60,42 Q54,30 46,32"/>
                                <Path Stroke="#FBBF24" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M68,42 Q74,30 82,32"/>
                                <!-- Left Wing -->
                                <Path Fill="#8038BDF8" Stroke="#38BDF8" StrokeThickness="1.5"
                                      Data="M56,52 C40,40 25,48 35,66 C42,75 52,65 56,52 Z"/>
                                <!-- Right Wing -->
                                <Path Fill="#8038BDF8" Stroke="#38BDF8" StrokeThickness="1.5"
                                      Data="M72,52 C88,40 103,48 93,66 C86,75 76,65 72,52 Z"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="BeeVPN" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#211B05" BorderBrush="#4A3B0B" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WINDOWS" FontSize="9" FontWeight="Bold" Foreground="#FFB800"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize & Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Template="{StaticResource TitleBtnTemplate}" Click="BtnMinimize_Click" Margin="0,0,4,0" ToolTip="Minimize to System Tray">
                            <TextBlock Text="—" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                        </Button>
                        <Button Template="{StaticResource CloseBtnTemplate}" Click="BtnClose_Click" ToolTip="Close BeeVPN">
                            <TextBlock Text="✕" Foreground="#AAAAAA" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Body Content (AnyConnect vertical layout) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,8,14,12">
                <StackPanel>

                    <!-- Top Status Badge Pill -->
                    <Border x:Name="borderStatusBadge" HorizontalAlignment="Center" Background="#261515" BorderBrush="#4A1E1E" BorderThickness="1" CornerRadius="12" Padding="14,4" Margin="0,2,0,8">
                        <TextBlock x:Name="tvStatusBadge" Text="○  DISCONNECTED" Foreground="#FF5252" FontSize="11" FontWeight="Bold"/>
                    </Border>

                    <!-- Mode Selector Dropdown -->
                    <Border Background="#181818" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,10">
                        <ComboBox x:Name="comboMode" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="12" FontWeight="SemiBold" SelectionChanged="ComboMode_SelectionChanged">
                            <ComboBoxItem Content="1. Psiphon Circumvention (Bypass)" IsSelected="True" Foreground="#FFFFFF" Background="#181818"/>
                            <ComboBoxItem Content="2. Cloudflare DNS (1.1.1.1 Fast)" Foreground="#FFFFFF" Background="#181818"/>
                        </ComboBox>
                    </Border>

                    <!-- Central Power Button Section -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,2,0,8">
                        <Button x:Name="btnToggleVpn" Template="{StaticResource PowerBtnTemplate}" Click="BtnToggleVpn_Click" Cursor="Hand"/>
                        <TextBlock x:Name="tvConnectionState" Text="DISCONNECTED" Foreground="#777777" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                        <TextBlock x:Name="tvHint" Text="Select network mode and click Connect" Foreground="#555555" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Server Fleet Card with Exact Vector Logo -->
                    <Border Background="#161616" BorderBrush="#242424" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="128" Height="128">
                                    <Path Fill="#151E2E" Stroke="#F59E0B" StrokeThickness="4" StrokeLineJoin="Round" Data="M64,6 L118,36 L118,92 L64,122 L10,92 L10,36 Z"/>
                                    <Path Fill="#FBBF24" Data="M64,55 L74,55 C77,65 77,80 64,95 C51,80 51,65 54,55 Z"/>
                                    <Path Fill="#0B0F19" Data="M56,66 L72,66 C71,72 70,75 64,80 C58,75 57,72 56,66 Z"/>
                                    <Path Fill="#0B0F19" Data="M59,84 L69,84 C68,88 66,91 64,93 C62,91 60,88 59,84 Z"/>
                                    <Path Fill="#F59E0B" Data="M64,40 C70,40 73,44 73,50 L55,50 C55,44 58,40 64,40 Z"/>
                                    <Path Stroke="#FBBF24" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M60,42 Q54,30 46,32"/>
                                    <Path Stroke="#FBBF24" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M68,42 Q74,30 82,32"/>
                                    <Path Fill="#8038BDF8" Stroke="#38BDF8" StrokeThickness="1.5" Data="M56,52 C40,40 25,48 35,66 C42,75 52,65 56,52 Z"/>
                                    <Path Fill="#8038BDF8" Stroke="#38BDF8" StrokeThickness="1.5" Data="M72,52 C88,40 103,48 93,66 C86,75 76,65 72,52 Z"/>
                                </Canvas>
                            </Viewbox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="tvServerTitle" Text="Psiphon Fleet (Auto)" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="tvServerSub" Text="Global obfuscated circumvention network" Foreground="#666666" FontSize="10"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" x:Name="tvLatency" Text="○ Idle" Foreground="#666666" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 3-Column Stats Card (Duration / Download / Upload) -->
                    <Border Background="#161616" BorderBrush="#242424" BorderThickness="1" CornerRadius="10" Padding="8,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Duration -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="DURATION" Foreground="#666666" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="tvDuration" Text="00:00:00" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#242424"/>

                            <!-- Download -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="DOWNLOAD" Foreground="#666666" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="tvDownload" Text="0.0 MB" Foreground="#FFB800" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#242424"/>

                            <!-- Upload -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="UPLOAD" Foreground="#666666" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="tvUpload" Text="0.0 MB" Foreground="#E0E0E0" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- App Routing (Split Tunnel) Card - Matching Android -->
                    <Border x:Name="cardAppRouting" Background="#161616" BorderBrush="#242424" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="CardAppRouting_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="📱" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="App Routing (Split Tunnel)" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="tvAppRoutingSub" Text="All PC apps routed (click to customize)" Foreground="#FFB800" FontSize="10"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="CHANGE ›" Foreground="#FFB800" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Live Connection Logs Section -->
                    <Border Background="#161616" BorderBrush="#242424" BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <StackPanel>
                            <!-- Header with Title & Action Buttons -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="📜 LIVE LOGS" Foreground="#FFB800" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnCopyLogs" Content="Copy" Background="#222222" Foreground="#CCCCCC" BorderBrush="#333333" BorderThickness="1" Padding="8,2" FontSize="10" Cursor="Hand" Click="BtnCopyLogs_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="btnClearLogs" Content="Clear" Background="#222222" Foreground="#888888" BorderBrush="#333333" BorderThickness="1" Padding="8,2" FontSize="10" Cursor="Hand" Click="BtnClearLogs_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Terminal Box -->
                            <Border Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Height="105">
                                <TextBox x:Name="txtLogs" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" FontFamily="Consolas" FontSize="10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. In-Window Modal Dialog Overlay for App Routing (Split Tunnel) -->
            <Grid Grid.RowSpan="2" x:Name="dialogSplitTunnel" Visibility="Collapsed" Background="#E0000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="344" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14" Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.8"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="App Routing (Split Tunnel)" Foreground="#FFB800" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Choose which applications route through BeeVPN." Foreground="#888888" FontSize="10" Margin="0,2,0,12"/>

                        <!-- Radio Options -->
                        <RadioButton x:Name="rbFullTunnel" GroupName="TunnelMode" Content="Route all PC applications (Default)" Foreground="#FFFFFF" FontSize="11" Margin="0,0,0,6" Checked="RbTunnelMode_Changed"/>
                        <RadioButton x:Name="rbSplitTunnel" GroupName="TunnelMode" Content="Route specific apps only (Split Tunnel)" Foreground="#FFFFFF" FontSize="11" Margin="0,0,0,10" Checked="RbTunnelMode_Changed"/>

                        <!-- Split Tunnel Panel with 1-Click Launchers -->
                        <Border x:Name="panelSplitApps" Background="#1A1A1A" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SELECT / LAUNCH APP VIA VPN:" Foreground="#AAAAAA" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>

                                <!-- Telegram -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✈️" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Telegram Desktop" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="Route Telegram" HorizontalAlignment="Right" Background="#262626" Foreground="#FFB800" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,3" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="BtnRouteTelegram_Click"/>
                                </Grid>

                                <!-- Chrome -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Google Chrome" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="Launch Isolated" HorizontalAlignment="Right" Background="#262626" Foreground="#FFB800" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,3" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="BtnLaunchChrome_Click"/>
                                </Grid>

                                <!-- Edge -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Microsoft Edge" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="Launch Isolated" HorizontalAlignment="Right" Background="#262626" Foreground="#FFB800" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,3" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="BtnLaunchEdge_Click"/>
                                </Grid>

                                <!-- Brave -->
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🦁" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Brave Browser" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="Launch Isolated" HorizontalAlignment="Right" Background="#262626" Foreground="#FFB800" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,3" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="BtnLaunchBrave_Click"/>
                                </Grid>

                                <!-- Custom App -->
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Other App (.exe)" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="Browse &amp; Run..." HorizontalAlignment="Right" Background="#262626" Foreground="#CCCCCC" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,3" FontSize="10" Cursor="Hand" Click="BtnBrowseCustomApp_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Endpoints Info -->
                        <Border Background="#1A1A1A" BorderBrush="#242424" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock x:Name="tvDialogSocksInfo" Text="SOCKS5: 127.0.0.1:----" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                                <Button Content="Copy SOCKS" HorizontalAlignment="Right" Background="#262626" Foreground="#FFB800" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,2" FontSize="9" FontWeight="Bold" Cursor="Hand" Click="BtnCopySocks_Click"/>
                            </Grid>
                        </Border>

                        <!-- Footer Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Background="Transparent" Foreground="#888888" BorderThickness="0" Padding="12,6" FontSize="11" Cursor="Hand" Click="BtnCloseSplitDialog_Click" Margin="0,0,6,0"/>
                            <Button Content="Apply &amp; Save" Background="#26200A" Foreground="#FFB800" BorderBrush="#5C450E" BorderThickness="1" Padding="14,6" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="BtnSaveSplitDialog_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
