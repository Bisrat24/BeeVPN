<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_bee_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/app_name"
                    android:textColor="@color/bee_gold"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_status_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/status_not_connected"
                android:textColor="@color/status_disconnected"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Mode Selector Dropdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK:"
                android:textColor="@color/bee_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <Spinner
                android:id="@+id/spinner_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <!-- Center Section: Big Round Connect Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_connection_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCONNECTED"
                android:textColor="@color/text_dim"
                android:letterSpacing="0.15"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <!-- Power Button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_toggle_vpn"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:background="@drawable/btn_connect_bg"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/connect"
                    android:elevation="6dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Select network mode and tap to connect"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Optimal Server Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bee_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_server_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/server_title"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_server_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatic fastest routing"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ Idle"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stats 3-Column Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <!-- Duration Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duration_label"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="00:00:00"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/card_stroke" />

            <!-- Download Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_label"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0.0 MB"
                    android:textColor="@color/bee_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/card_stroke" />

            <!-- Upload Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_label"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_upload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0.0 MB"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- App Routing / Split Tunneling Card -->
        <LinearLayout
            android:id="@+id/card_app_routing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_app_routing_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Routing (Split Tunnel)"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_app_routing_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All device apps routed (tap to customize)"
                    android:textColor="@color/bee_gold"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHANGE ›"
                android:textColor="@color/bee_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LIVE LOG VIEWING SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="18dp">

            <!-- Log Bar Title & Action Buttons -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📜 LIVE CONNECTION LOGS"
                    android:textColor="@color/bee_gold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true">

                    <Button
                        android:id="@+id/btn_copy_logs"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="COPY"
                        android:textSize="10sp"
                        android:textColor="@color/text_white"
                        android:background="@drawable/badge_status_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_clear_logs"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="CLEAR"
                        android:textSize="10sp"
                        android:textColor="@color/text_white"
                        android:background="@drawable/badge_status_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Scrollable Terminal Window -->
            <ScrollView
                android:id="@+id/scroll_logs"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#0A0C10"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[READY] BeeVPN Log Console initialized.\n"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
